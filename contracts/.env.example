# Copy to .env inside contracts/ — Foundry loads env vars from the working
# directory, not the repo root.

TESTNET_RPC_URL=https://rpc.bohr.life
MAINNET_RPC_URL=https://rpc.botchain.ai

# Never commit real values.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Only needed if verifying contracts on the explorer.
EXPLORER_API_KEY=
