# Copy to .env inside contracts/ — Foundry loads env vars from the working
# directory, not the repo root.

TESTNET_RPC_URL=https://rpc.bohr.life
MAINNET_RPC_URL=https://rpc.botchain.ai

# Never commit real values.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Only needed if verifying contracts on the explorer.
EXPLORER_API_KEY=

# --- script/Deploy.s.sol ---------------------------------------------------
# The single trusted signer Settlement.confirmPayout() checks against. See
# the "known weak point" note in README.md before treating this as more
# than a v1 placeholder.
ORACLE_SIGNER_ADDRESS=

# The underwriter agent's signing address, registered into AgentRegistry
# at deploy time. Never the deployer key — a separate key services/agent
# controls to sign EIP-712 attestations.
AGENT_ADDRESS=
AGENT_NAME="Kreda Underwriter v1"

# --- script/DeployVault.s.sol (one ReceivableVault per receivable) --------
ASSET_ADDRESS=
ATTESTATION_ADDRESS=
SETTLEMENT_ADDRESS=
TREASURY_ADDRESS=
ATTESTATION_ID=
TARGET_AMOUNT=
YIELD_BPS=
MATURITY_TIMESTAMP=
FEE_BPS=
VAULT_NAME=
VAULT_SYMBOL=
