# Shared chain config — copy to .env in each app/service that needs it

# BOT Chain testnet (deploy here first)
TESTNET_CHAIN_ID=968
TESTNET_RPC_URL=https://rpc.bohr.life
TESTNET_EXPLORER_URL=https://scan.bohr.life

# BOT Chain mainnet (release only)
MAINNET_CHAIN_ID=677
MAINNET_RPC_URL=https://rpc.botchain.ai
MAINNET_EXPLORER_URL=https://scan.botchain.ai

# Deployer key and address — never commit real values
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Shopify custom app (Partners development store)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
