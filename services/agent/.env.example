# Copy to .env inside services/agent/ — pydantic-settings loads env vars
# from the working directory, not the repo root.

TESTNET_RPC_URL=https://rpc.bohr.life
MAINNET_RPC_URL=https://rpc.botchain.ai
# 968 (testnet) for local dev, always — see CLAUDE.md. Production is 677;
# see render.yaml for the deployed service's actual value.
CHAIN_ID=968

# Never commit real values.
AGENT_PRIVATE_KEY=
ATTESTATION_CONTRACT_ADDRESS=
AGENT_REGISTRY_CONTRACT_ADDRESS=

# "fixture" (default) or "shopify" — see app/data_provider. The demo and
# the test suite run against generated fixtures; Shopify's custom-app
# token flow is implemented but unverified against a live store — see
# app/shopify/client.py's module docstring.
KREDA_DATA_PROVIDER=fixture

# Comma-separated. Set to the deployed frontend's real origin(s) in
# production — never "*"; see app/main.py.
CORS_ALLOWED_ORIGINS=http://localhost:3000

SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01

# Stage 3 — decide. LLM_PROVIDER is "anthropic" (default) or "venice" —
# only the selected provider's key needs to be set. Never commit a real
# key; the SDK also picks up ANTHROPIC_API_KEY directly if you'd rather
# not route it through settings.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
VENICE_API_KEY=
VENICE_MODEL=llama-3-3-70b

# Stage 4 — commit. "blob" is not implemented yet — see app/chain/blob.py;
# whether chain 677 accepts user-submitted blob transactions is still an
# open question per CLAUDE.md.
EVIDENCE_COMMITMENT_METHOD=calldata_hash_tree

EVIDENCE_STORE_DIR=./data/evidence
SNAPSHOT_CACHE_DIR=./data/snapshots
SNAPSHOT_CACHE_MAX_AGE_SECONDS=3600

INGEST_WINDOW_DAYS=90

# Raw uint256 units Attestation.Record.faceValue is signed in. 6 = USDC.
STABLECOIN_DECIMALS=6
